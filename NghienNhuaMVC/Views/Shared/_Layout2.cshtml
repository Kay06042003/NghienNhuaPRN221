    <script>
        var boxSearch = document.getElementById("collapseExample");
        var txtSearch = document.getElementById("txtSearch");
        document.addEventListener("click", function (e) {
            if (e.target !== boxSearch) {
                boxSearch.classList.remove("show");
            }
        })
        function funcSearch(para) {
            var txtSearch = para.value;
            if (txtSearch.length > 3) {
                $.ajax({
                    url: "/Product/Search",
                    type: "get",
                    data: {
                        txt: txtSearch
                    },
                    success: function (data) {
                        // Xử lý kết quả tìm kiếm
                        displaySearchResults(data);
                        // Hiển thị collapse
                        boxSearch.classList.add("show");
                    },
                    error: function (asfd) {
                        // Xử lý lỗi nếu có
                    }
                });
            }

        }

        function displaySearchResults(results) {
            // Hiển thị kết quả tìm kiếm trong thẻ div có id="content"
            var contentDiv = document.getElementById("content");
            contentDiv.innerHTML = ""; // Xóa nội dung cũ trước khi hiển thị kết quả mới
            var string = "";
            results.forEach(function (item) {
                var imgae = item.proImage.split("&");
                // show all product
                string += "<a class='text-decoration-none text-dark' href='/Product/ProductDetail/" + item.proId + "?proCategory=" + item.proCategory + "' class='searchBoxProduct-item'>"
                    + "<div class='row' style='width: 100%; height: auto; font-size: 14px'>"
                    + "<div class='col-3 p-0'>"
                    + "<img src='/Images/Product/" + imgae[0] + "' style='width: 100%' alt=''>"
                    + "</div>"
                    + "<div class='col-7 p-0'>"
                    + "<p class='d-block' style='word-wrap: break-word;'>" + item.proName + "</p>"
                    + "</div>"
                    + "<div class='col-2 p-0'>"
                    + "<p style='font-size: 12px'>" + item.proPrice + "đ</p>"
                    + "</div>"
                    + "</div>"
                    + "</a>";

            });
            contentDiv.innerHTML = string;
        }

        $(document).ready(function () {
            $(".btn-plus, .btn-minus").on("click", function () {
                var btn = $(this);
                var productId = btn.data("proid");
                var cartID = btn.data("cartid");
                var inputField = $(".quantity-input[data-proid='" + productId + "']");
                var currentQuantity = parseInt(inputField.val());
                if (btn.hasClass("btn-plus")) {
                    inputField.val(currentQuantity + 1);
                } else {
                    if (currentQuantity > 1) {
                        inputField.val(currentQuantity - 1);
                    }
                }

                var newQuantity = inputField.val();

                // Thực hiện yêu cầu AJAX để cập nhật số lượng trong cơ sở dữ liệu
                $.ajax({
                    type: "GET",
                    url: "/Cart/UpdateCart",
                    data: {
                        cartId: cartID,
                        productId: productId,
                        quantity: newQuantity
                    },
                    success: function (response) {
                        console.log(response);
                        if (response.status == "error") {
                            inputField.val(currentQuantity);
                            alert("Vượt quá số lượng sản phẩm.");
                        } else {
                            var money = response.totalString;
                            var total = response.totalMoneyString;
                            var final = response.finalString;
                            $(".ItemProduct1[data-proid='" + productId + "'] span").text(money); // Cập nhật số tiền tạm tính
                            $(".before").text(total); // Cập nhật số tiền tạm tính
                            $(".final").text(final); // Cập nhật số tiền tạm tính
                        }
                    },
                    error: function () {
                        // Xử lý lỗi nếu cần
                    }
                });
            });
        });


    </script>

     @{

