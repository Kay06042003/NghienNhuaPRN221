<Page x:Class="NghienNhuaWPF.View.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:NghienNhuaWPF.View"
      xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:uc="clr-namespace:NghienNhuaWPF.UserControll"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800">
    <!--Main Section-->
    <Border Grid.Column="1"
            CornerRadius="0 10 10 0">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,0"
                                 EndPoint="0,1">
                <GradientStop Color="#41518F"
                              Offset="0"/>
                <GradientStop Color="#2C386C"
                              Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>



            <!--Info Cards-->
            <Grid Grid.Row="0"
                  Margin="50 20 15 40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <uc:InfoCard Grid.Column="0"
                             Title="Total Orders"
                             Number="{Binding TotalOrders}"
                             Icon="Message"
                             Background1="#827BFF"
                             Background2="#D9B5FF"
                             EllipseBackground1="#B298FD"
                             EllipseBackground2="#E4BBFF"/>
                <uc:InfoCard Grid.Column="1"
                             Title="Pending Orders"
                             Number="{Binding PendingOrders}"
                             Icon="ShoppingCart"
                             Background1="#FD8A87"
                             Background2="#F3AB92"
                             EllipseBackground1="#FBD5A8"
                             EllipseBackground2="#FDB89B"/>
                <uc:InfoCard Grid.Column="2"
                             Title="Total Revenue"
                             Number="{Binding TotalRevenue}"
                             Icon="Coins"
                             Background1="#FC84CB"
                             Background2="#FC8FAE"
                             EllipseBackground1="#FC8FAE"
                             EllipseBackground2="#FFABE6"/>
            </Grid>

            <!--Chart Section-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>

                </Grid.ColumnDefinitions>

                <Grid  Grid.Column="0">
                    <lvc:CartesianChart Series="{Binding SeriesCollection}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Margin="20">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Months"
                                      Labels="{Binding Labels}"
                                      FontSize="14">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>

                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis  LabelFormatter="{Binding Formatter}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
                <Grid Grid.Column="1">
                    <lvc:PieChart Series="{Binding PieSeriesCollection}"
                                  LegendLocation="Right">
                    </lvc:PieChart>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
