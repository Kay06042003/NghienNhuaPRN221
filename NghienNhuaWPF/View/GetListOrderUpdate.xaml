<Page x:Class="NghienNhuaWPF.View.GetListOrderUpdate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
                     xmlns:conver="clr-namespace:NghienNhuaWPF.Utilities"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks" 
      mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000">
    <Page.Resources>
        <conver:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#200F53"
                CornerRadius="10" 
                Padding="10" Grid.RowSpan="3">
            <DataGrid ColumnWidth="*"
                  Background="#200F53"
                  BorderThickness="0"
                  HeadersVisibility="Column" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding selectedOrder, Mode=TwoWay}">
                <DataGrid.Resources>
                    <!-- Style for the DataGrid itself -->
                    <Style TargetType="DataGrid">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                    </Style>

                    <!-- Style for the DataGrid rows -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                    </Style>

                    <!-- Style for the DataGrid cells -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                    </Style>

                    <!-- Style for the DataGrid column headers -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Order Id" Binding="{Binding OrderId}" Width="*"/>
                    <DataGridTextColumn Header="User Id" Binding="{Binding UserId}" Width="*"/>
                    <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate}" Width="*"/>
                    <DataGridTextColumn Header="Order Name" Binding="{Binding OrderName}" Width="*"/>
                    <DataGridTextColumn Header="Order Total Money" Binding="{Binding OrderTotalMoney}" Width="*"/>
                    <DataGridTextColumn Header="Order Phone Number" Binding="{Binding OrderPhoneNumber}" Width="*"/>
                    <DataGridTextColumn Header="Order Email" Binding="{Binding OrderEmail}" Width="*"/>
                    <DataGridTextColumn Header="Order Address" Binding="{Binding OrderAddress}" Width="*"/>
                    <DataGridTextColumn Header="Order Status" Binding="{Binding OrderStatus}" Width="*"/>
                    <DataGridTemplateColumn Header="Trạng Thái Cập Nhật" >
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate>
                                <ComboBox  x:Name="combobox_Gender" Text="{Binding OrderStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15">
                                    <ComboBoxItem Content="Giao Hàng Thành Công - COD" />
                                    <ComboBoxItem Content="Giao Hàng Thất Bại - COD" />
                                    <ComboBoxItem Content="Đang Chuẩn Bị Hàng - COD" />
                                    <ComboBoxItem Content="Đang Giao Hàng - COD" />
                                    <ComboBoxItem Content="Giao Hàng Thành Công - Banking" />
                                    <ComboBoxItem Content="Giao Hàng Thất Bại - Banking" />
                                    <ComboBoxItem Content="Đang Chuẩn Bị Hàng - Banking" />
                                    <ComboBoxItem Content="Đang Giao Hàng - Banking" />
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  Header="Update" IsReadOnly="True" Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel  HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button CommandParameter="{Binding OrderId}"
                                         Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                         Margin="5 0 0 0" Style="{StaticResource gridEditButton}">
                                        <Icon:PackIconMaterial Kind="Refresh" Style="{StaticResource gridButtonIcon}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
