<Page x:Class="NghienNhuaWPF.View.OrderConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
                     xmlns:conver="clr-namespace:NghienNhuaWPF.Utilities"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks" 
      mc:Ignorable="d" 
             d:DesignHeight="450"
 d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#200F53"
                CornerRadius="10" 
                Padding="10">
            <DataGrid ColumnWidth="*"
                  Background="#200F53"
                  BorderThickness="0"
                  HeadersVisibility="Column" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding selectedOrder, Mode=TwoWay}">
                <DataGrid.Resources>
                    <!-- Style for the DataGrid itself -->
                    <Style TargetType="DataGrid">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                    </Style>

                    <!-- Style for the DataGrid rows -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                    </Style>

                    <!-- Style for the DataGrid cells -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                    </Style>

                    <!-- Style for the DataGrid column headers -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Order Id" Binding="{Binding OrderId}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Name" Binding="{Binding OrderName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Total Money" Binding="{Binding OrderTotalMoney}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Phone Number" Binding="{Binding OrderPhoneNumber}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Email" Binding="{Binding OrderEmail}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Address" Binding="{Binding OrderAddress}" Width="*" IsReadOnly="True"/>


                    <DataGridTemplateColumn  Header="Confirm" IsReadOnly="True" Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel  HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button CommandParameter="{Binding OrderId}"
                                         Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                         Margin="5 0 0 0" Style="{StaticResource gridEditButton}">
                                        <Icon:PackIconMaterial Kind="Check" Style="{StaticResource gridButtonIcon}"/>
                                    </Button>
                                    <Button CommandParameter="{Binding OrderId}"
                                         Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                         Margin="5 0 0 0" Style="{StaticResource gridEditButton}">
                                        <Icon:PackIconMaterial Kind="Close" Style="{StaticResource gridButtonIcon}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>



        <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource panelColor}" Margin="0,10,0,0" Grid.RowSpan="2">
            <!-- ID -->
            <Border Grid.Row="0"
         Background="#200F53"
         CornerRadius="10" 
         Padding="10">
                <DataGrid ColumnWidth="*"
           Background="#200F53"
           BorderThickness="0"
           HeadersVisibility="Column" 
           AutoGenerateColumns="False"
           CanUserAddRows="False"
           ItemsSource="{Binding OrderDetails}" Margin="0,-24,0,0">
                    <DataGrid.Resources>
                        <!-- Style for the DataGrid itself -->
                        <Style TargetType="DataGrid">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#BCBEE0"/>
                            <Setter Property="FontFamily" Value="Montserrat"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="Padding" Value="10,0,0,10"/>
                        </Style>

                        <!-- Style for the DataGrid rows -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#BCBEE0"/>
                            <Setter Property="FontFamily" Value="Montserrat"/>
                            <Setter Property="FontSize" Value="15"/>
                        </Style>

                        <!-- Style for the DataGrid cells -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#BCBEE0"/>
                            <Setter Property="FontFamily" Value="Montserrat"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="Padding" Value="10,0,0,10"/>
                        </Style>

                        <!-- Style for the DataGrid column headers -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#BCBEE0"/>
                            <Setter Property="FontFamily" Value="Montserrat"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="Padding" Value="10,0,0,10"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Od Id" Binding="{Binding OdId}" Width="*"/>
                        <DataGridTextColumn Header="OrderId" Binding="{Binding OrderId}" Width="*"/>
                        <DataGridTextColumn Header="ProId" Binding="{Binding ProId}" Width="*"/>
                        <DataGridTextColumn Header="OdPrice" Binding="{Binding OdPrice}" Width="*"/>
                        <DataGridTextColumn Header="OdQuantity" Binding="{Binding OdQuantity}" Width="*"/>
                        <DataGridTextColumn Header="OdTotalMoney" Binding="{Binding OdTotalMoney}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>




        </Grid>
    </Grid>
</Page>