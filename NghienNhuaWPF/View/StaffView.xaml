<Page x:Class="NghienNhuaWPF.View.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NghienNhuaWPF.View"
             xmlns:conver="clr-namespace:NghienNhuaWPF.Utilities"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:usercontroll ="clr-namespace:NghienNhuaWPF.UserControll"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000">
    <Page.Resources>
        <conver:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#200F53"
                CornerRadius="10" 
                Padding="10">
            <DataGrid ColumnWidth="*"
                  Background="#200F53"
                  BorderThickness="0"
                  HeadersVisibility="Column" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Staffs}"
                  SelectedItem="{Binding selectedStaff, Mode=TwoWay}">
                <DataGrid.Resources>
                    <!-- Style for the DataGrid itself -->
                    <Style TargetType="DataGrid">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                    </Style>

                    <!-- Style for the DataGrid rows -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                    </Style>

                    <!-- Style for the DataGrid cells -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                    </Style>

                    <!-- Style for the DataGrid column headers -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BCBEE0"/>
                        <Setter Property="FontFamily" Value="Montserrat"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding StaffId}"  Header="ID" />
                    <DataGridTextColumn Binding="{Binding StaffFullname}"  Header="Full name"/>
                    <DataGridTextColumn Binding="{Binding StaffGender}"  Header="Gender"/>
                    <DataGridTextColumn Binding="{Binding StaffSalary}"  Header="Salary"/>
                    <DataGridTextColumn Binding="{Binding StaffPhoneNumber}" Header="Phone"/>
                    <DataGridTextColumn Binding="{Binding StaffAddress}" Header="Address"/>
                    <DataGridTextColumn Binding="{Binding StaffDateOfBirth}" Header="BirthDay"/>
                    <DataGridTextColumn Binding="{Binding StaffStatus}" Header="Status"/>
                    <DataGridTemplateColumn  Header="Operations" IsReadOnly="True" Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel  HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button Style="{StaticResource gridEditButton}">
                                        <Icon:PackIconMaterial Kind="PencilOutline" Style="{StaticResource gridButtonIcon}"/>
                                    </Button>
                                    <Button CommandParameter="{Binding StaffId}"
                                         Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                         Margin="5 0 0 0" Style="{StaticResource gridRemoveButton}">
                                        <Icon:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource gridButtonIcon}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Background="#210F55" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Height="25" Text="Details" FontWeight="Bold" FontSize="20" TextAlignment="Center" Foreground="White" />

        <Grid Grid.Row="2" Grid.Column="0" Background="{StaticResource panelColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ID -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID :" HorizontalAlignment="Right" VerticalAlignment="Center"
                FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <TextBox IsReadOnly="True" Grid.Row="0" Grid.Column="1" x:Name="textbox_StaffID" Text="{Binding staffId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
            BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15" />

            <!-- FullName -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Full name :" HorizontalAlignment="Right" VerticalAlignment="Center"
           FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="textbox_StaffFullName" Text="{Binding staffFullname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
         BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15" />

            <!-- Salary -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Salary :" HorizontalAlignment="Right" VerticalAlignment="Center"
           FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="textbox_StaffSalary" Text="{Binding staffSalary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
         BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15" />

            <!-- Phone Number -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Phone number :" HorizontalAlignment="Right" VerticalAlignment="Center"
           FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="textbox_StaffPhone" Text="{Binding staffPhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
         BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15" />

            <!-- Date of Birth -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Date of Birth :" HorizontalAlignment="Right" VerticalAlignment="Center"
           FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <DatePicker Grid.Row="4" Grid.Column="1" x:Name="datepicker_DateOfBirth" Text="{Binding staffDateOfBirth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
            BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15" />

            <!-- Address -->
            <TextBlock Grid.Row="3" Grid.Column="2" Text="Address :" HorizontalAlignment="Right" VerticalAlignment="Center"
            FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <TextBox Grid.Row="3" Grid.Column="3" x:Name="textbox_Address" Text="{Binding staffAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
            BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15" />

            <!-- Gmail -->
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Email :" HorizontalAlignment="Right" VerticalAlignment="Center"
            FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="textbox_Gmail" Text="{Binding staffGmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
            BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15"
            IsReadOnly="{Binding IsItemSelected}"/>

            <!-- Password-->
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Password :" HorizontalAlignment="Right" VerticalAlignment="Center"
                FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <usercontroll:StaffBinadablePassword  IsEnabled="{Binding IsItemSelected, Converter={StaticResource InverseBooleanConverter}}" Grid.Row="1" Grid.Column="3" Password="{Binding staffPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            </usercontroll:StaffBinadablePassword>

            <!-- Citizen Number -->
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Citizen number :" HorizontalAlignment="Right" VerticalAlignment="Center"
           FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <TextBox Grid.Row="2" Grid.Column="3" x:Name="textbox_Identity" Text="{Binding staffCitizenIdentityNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
         BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15" />

            <!-- Gender -->
            <TextBlock Grid.Row="4" Grid.Column="2" Text="Gender :" HorizontalAlignment="Right" VerticalAlignment="Center"
             FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <ComboBox Grid.Row="4" Grid.Column="3" x:Name="combobox_Gender" Text="{Binding staffGender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
            BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15">
                <ComboBoxItem Content="Male" />
                <ComboBoxItem Content="Female" />
            </ComboBox>

            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- Add Button -->
                <Button x:Name="Add" Content="ADD" Command="{Binding AddStaffCommand}" Width="100" Height="35" Margin="10" 
                FontFamily="Montserrat" FontSize="14" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3498DB"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2980B9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Update Button -->
                <Button x:Name="Update" Content="UPDATE" Command="{Binding UpdateStaffCommand}" Width="100" Height="35" Margin="5" 
            FontFamily="Montserrat" FontSize="14" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F39C12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E67E22"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Delete Button -->
                <Button x:Name="Delete" Content="CANCLE" Command="{Binding CancelCommand}" Width="100" Height="35" Margin="5" 
            FontFamily="Montserrat" FontSize="14" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#E74C3C"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C0392B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
