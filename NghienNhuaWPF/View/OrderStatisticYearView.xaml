<Page x:Class="NghienNhuaWPF.View.OrderStatisticYearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NghienNhuaWPF.View"
             xmlns:conver="clr-namespace:NghienNhuaWPF.Utilities"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:usercontroll ="clr-namespace:NghienNhuaWPF.UserControll"
             mc:Ignorable="d" 
                        d:DesignHeight="450"
 d:DesignWidth="800">
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="1"
            Background="#200F53"
            CornerRadius="10"
            Padding="10">
            <DataGrid ColumnWidth="*"
                  Background="#200F53"
                  BorderThickness="0"
                  HeadersVisibility="Column"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding selectedOrder, Mode=TwoWay}">
                <DataGrid.Resources>
                    <!-- Style for the DataGrid itself -->
                    <Style TargetType="DataGrid">
                        <Setter Property="Background"
                            Value="Transparent"/>
                        <Setter Property="Foreground"
                            Value="#BCBEE0"/>
                        <Setter Property="FontFamily"
                            Value="Montserrat"/>
                        <Setter Property="FontSize"
                            Value="15"/>
                        <Setter Property="Padding"
                            Value="10,0,0,10"/>
                    </Style>

                    <!-- Style for the DataGrid rows -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background"
                            Value="Transparent"/>
                        <Setter Property="Foreground"
                            Value="#BCBEE0"/>
                        <Setter Property="FontFamily"
                            Value="Montserrat"/>
                        <Setter Property="FontSize"
                            Value="15"/>
                    </Style>

                    <!-- Style for the DataGrid cells -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background"
                            Value="Transparent"/>
                        <Setter Property="Foreground"
                            Value="#BCBEE0"/>
                        <Setter Property="FontFamily"
                            Value="Montserrat"/>
                        <Setter Property="FontSize"
                            Value="15"/>
                        <Setter Property="Padding"
                            Value="10,0,0,10"/>
                    </Style>

                    <!-- Style for the DataGrid column headers -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                            Value="Transparent"/>
                        <Setter Property="Foreground"
                            Value="#BCBEE0"/>
                        <Setter Property="FontFamily"
                            Value="Montserrat"/>
                        <Setter Property="FontSize"
                            Value="15"/>
                        <Setter Property="Padding"
                            Value="10,0,0,10"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order Id" Binding="{Binding OrderId}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Name" Binding="{Binding OrderName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Total Money" Binding="{Binding OrderTotalMoney}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Phone Number" Binding="{Binding OrderPhoneNumber}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Email" Binding="{Binding OrderEmail}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Address" Binding="{Binding OrderAddress}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Background="#210F55"
               Grid.Row="2"
               Grid.Column="1"
               Grid.ColumnSpan="4"
               Height="25"
               Text="Year Statistic"
               FontWeight="Bold"
               FontSize="20"
               TextAlignment="Center"
               Foreground="White"/>

        <Grid Grid.Row="3"
          Grid.Column="0"
          Background="{StaticResource panelColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>








            <TextBlock Grid.Row="0" Grid.Column="0" Text="Year :" HorizontalAlignment="Right" VerticalAlignment="Center"
       FontWeight="Bold" FontSize="15" Foreground="#BCBEE0" FontFamily="Montserrat" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="textbox_Days" Text="{Binding YearStatistic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
   Width="350" Padding="5" Margin="0,5,0,0" Background="#200F53" Foreground="#BCBEE0"
   BorderBrush="#BCBEE0" BorderThickness="0,0,0,1" FontFamily="Montserrat" FontSize="15" />






            <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

                <!-- Add Button -->
                <Button x:Name="Get" Content="Get" CommandParameter="{Binding YearStatistic}" 
                      Command="{Binding DataContext.GetStatisticYearCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    Width="100" Height="35" 
            FontFamily="Montserrat" FontSize="14" Foreground="White" Cursor="Hand" BorderThickness="0" RenderTransformOrigin="1.095,-0.134" Grid.Column="2" Margin="0,30" Grid.ColumnSpan="2">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#F39C12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E67E22"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Update Button -->
                <Button x:Name="Excel" Content="Export Excel"  
          Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Page}}"
        Width="100" Height="35" 
FontFamily="Montserrat" FontSize="14" Foreground="White" Cursor="Hand" BorderThickness="0" RenderTransformOrigin="1.095,-0.134" Grid.Column="3" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#F39C12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E67E22"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>