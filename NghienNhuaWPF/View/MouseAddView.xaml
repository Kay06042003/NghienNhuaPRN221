<Window x:Class="NghienNhuaWPF.View.MouseAddView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NghienNhuaWPF.View"
        mc:Ignorable="d"
        Title="MouseAddView"
        Height="500"
        Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Background="#210F55"
                   Grid.Row="0"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Height="25"
                   Text="Add new Mouse"
                   FontWeight="Bold"
                   FontSize="20"
                   TextAlignment="Center"
                   Foreground="White"/>

        <Grid Grid.Row="1"
              Grid.Column="0"
              Background="{StaticResource panelColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>




            <!-- Name -->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Name :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Text="{Binding ProName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>


            <!-- Quantity -->
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Quantity :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding ProQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>

            <!-- Price -->
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Price :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding ProPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>

            <!-- Discount -->
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Discount :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Text="{Binding ProDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>

            <!-- Origin -->
            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="Origin :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Text="{Binding ProOrigin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>

            <!-- Brand -->
            <TextBlock Grid.Row="5"
                       Grid.Column="0"
                       Text="Brand :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="5"
                     Grid.Column="1"
                     Text="{Binding ProBrand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>

            <!-- Description -->
            <TextBlock Grid.Row="6"
                       Grid.Column="0"
                       Text="Description :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="6"
                     Grid.Column="1"
                     Text="{Binding ProDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="50"/>


            <!-- MouseDpi -->
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Dpi :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="0"
                     Grid.Column="3"
                     Text="{Binding MouseDpi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>
            <!-- MouseWireLength -->
            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Text="Wire Length :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="1"
                     Grid.Column="3"
                     Text="{Binding MouseWireLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>
            <!-- MouseLed -->
            <TextBlock Grid.Row="2"
                       Grid.Column="2"
                       Text="Led :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="2"
                     Grid.Column="3"
                     Text="{Binding MouseLed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>
            <!-- MouseTypeBattery -->
            <TextBlock Grid.Row="3"
                       Grid.Column="2"
                       Text="Type Battery :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="3"
                     Grid.Column="3"
                     Text="{Binding MouseTypeBattery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>
            <!-- MouseWeight -->
            <TextBlock Grid.Row="4"
                       Grid.Column="2"
                       Text="Weight :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="4"
                     Grid.Column="3"
                     Text="{Binding MouseWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>
            <!-- MouseCompatibility -->
            <TextBlock Grid.Row="5"
                       Grid.Column="2"
                       Text="Compatibility :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <TextBox Grid.Row="5"
                     Grid.Column="3"
                     Text="{Binding MouseCompatibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="350"
                     Padding="5"
                     Margin="0,5,0,0"
                     Background="#200F53"
                     Foreground="#BCBEE0"
                     BorderBrush="#BCBEE0"
                     BorderThickness="0,0,0,1"
                     FontFamily="Montserrat"
                     FontSize="15"/>

            <!-- Image -->
            <TextBlock Grid.Row="6"
                       Grid.Column="2"
                       Text="Image :"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#BCBEE0"
                       FontFamily="Montserrat"/>
            <Grid Grid.Row="6"
                  Grid.Column="3">
                <!-- TextBox -->
                <TextBox
                    Text="{Binding ProImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="True"
                    Width="250"
                    Padding="4"
                    Margin="0,5,0,0"
                    Background="#200F53"
                    Foreground="#BCBEE0"
                    BorderBrush="#BCBEE0"
                    BorderThickness="0,0,0,1"
                    FontFamily="Montserrat"
                    FontSize="15"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    Height="70"/>

                <!-- Button -->
                <Button
                    Content="Upload"
                    Command="{Binding SelectImagesCommand}"
                    Width="80"
                    Height="30"
                    HorizontalAlignment="Right"
                    Margin="5"
                    VerticalAlignment="Center"
                    Background="#3498DB"
                    Foreground="White"
                    Cursor="Hand"
                    BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"
                                    Value="#3498DB"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="18"
                                                Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#2980B9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <StackPanel Margin="10"
                        Grid.Row="8"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">


                <!-- Update Button -->
                <Button x:Name="Update"
                        Content="ADD"
                        Command="{Binding AddMouseCommand}"
                        Width="100"
                        Height="35"
                        Margin="5"
                        FontFamily="Montserrat"
                        FontSize="14"
                        Foreground="White"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"
                                    Value="#F39C12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="18"
                                                Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#E67E22"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Delete Button -->
                <Button x:Name="Delete"
                        Content="BACK TO LIST"
                        Command="{Binding BackToListCommand}"
                        Width="100"
                        Height="35"
                        Margin="5"
                        FontFamily="Montserrat"
                        FontSize="14"
                        Foreground="White"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"
                                    Value="#E74C3C"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="18"
                                                Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#C0392B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
